# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/artifacts
/.artifacts

# local runtime state
/.datadev-server.pid
/artifactsdev-server*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8
*.jks
*.keystore
/android/app/google-services.json
/ios/App/App/GoogleService-Info.plist
/.data

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!deploy/.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
