# Copy this file to /etc/q-academy/production.env and set mode 0600.
# Generate every blank secret independently, for example with:
#   openssl rand -hex 32
# The bootstrap login is the only PostgreSQL superuser and is reserved for
# initialization, backups, and restores. OWNER/APP/MEDIA are distinct
# non-superusers. All four role names become immutable after initialization;
# passwords remain rotatable. Generate every database password independently
# as exactly 64 hexadecimal characters (`openssl rand -hex 32`).
# Reserved example hostnames below are intentionally rejected at runtime until
# every public domain and contact has been replaced with an approved real value.

COMPOSE_PROJECT_NAME=q-academy
APP_IMAGE_TAG=

# Production releases fail closed until every upstream image is pinned to a
# provider-published immutable digest, for example name:tag@sha256:<64-hex>.
# Record the resolved references in the release evidence; never guess a digest.
NODE_IMAGE=
# Fallback for drills and RELEASE_IMAGE_MODE=local-build. A normal
# verified-manifest deployment replaces this with the attested
# Q_ACADEMY_POSTGRES_IMAGE digest and persists that digest after readiness.
POSTGRES_IMAGE=
CLAMAV_IMAGE=
# FreshClam checks twelve times per day. Deploy and scanner health fail closed
# when daily signatures are older than 36 hours.
FRESHCLAM_CHECKS=12
CLAMAV_SIGNATURE_MAX_AGE_SECONDS=129600
PROMETHEUS_IMAGE=
NODE_EXPORTER_IMAGE=

# Exact canonical platform hostname. It is passed into the app and must match
# the hostname of NEXT_PUBLIC_APP_URL generated by compose.
APP_DOMAIN=academy.example.com
# Static platform hosts only. Verified customer domains use On-Demand TLS.
CADDY_SITE_ADDRESSES=academy.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=q_academy
POSTGRES_BOOTSTRAP_USER=q_academy_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=
OWNER_POSTGRES_USER=q_academy_owner
OWNER_POSTGRES_PASSWORD=
APP_POSTGRES_USER=q_academy_app
APP_POSTGRES_PASSWORD=
MEDIA_POSTGRES_USER=q_academy_media
MEDIA_POSTGRES_PASSWORD=

SESSION_SECRET=
AUTH_RATE_LIMIT_SECRET=
# Dedicated random bearer secret shared only by Caddy and the app.
CADDY_TLS_ASK_SECRET=
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY_ID=webhook-2026-01
# JSON object of retained read keys, for example:
# WEBHOOK_ENCRYPTION_PREVIOUS_KEYS={"webhook-2025-07":"<old-secret>"}
WEBHOOK_ENCRYPTION_PREVIOUS_KEYS=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=data-2026-01
# JSON object of retained read keys. TOTP secrets use this keyring too. Keep
# the previous key until `npm run encryption:rotate -- --execute` followed by
# `--check` reports `mfaTotpSecrets: 0`.
DATA_ENCRYPTION_PREVIOUS_KEYS=
TENANT_ERASURE_MIN_WAIT_DAYS=30
# Base64url-encoded random bytes used to authenticate audit and erasure evidence.
# Retain the matching key ID for as long as signed evidence must be verified.
AUDIT_EXPORT_HMAC_KEY=
AUDIT_EXPORT_HMAC_KEY_ID=audit-2026-01
# Dedicated operator mounts. Input is mounted read-only; output must support
# hard links and is the only persistent writable path in export containers.
OPERATIONS_INPUT_DIR=/var/lib/q-academy/operations-input
OPERATIONS_EXPORT_DIR=/var/lib/q-academy/operations-exports
# Host file containing one dedicated API key with only courses:read.
HTTP_SLO_API_KEY_SOURCE_FILE=/etc/q-academy/http-slo-api-key
MFA_RECOVERY_PEPPER=
MFA_RECOVERY_PEPPER_ID=mfa-recovery-2026-01
# JSON object of retained recovery peppers, for example:
# MFA_RECOVERY_PREVIOUS_PEPPERS={"mfa-recovery-2025-07":"<old-secret>"}
# Recovery hashes cannot be rewritten without the original code. Retain an old
# pepper until no stored recovery envelope references its ID.
MFA_RECOVERY_PREVIOUS_PEPPERS=
PRIVACY_SUBJECT_HMAC_SECRET=
EXAM_SELECTION_SECRET=
CRON_SECRET=
MEDIA_CRON_SECRET=
METRICS_SECRET=
MEDIA_METRICS_SECRET=

# Optionales internes Monitoring-Profil (Prometheus bleibt auf 127.0.0.1).
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_APP_BEARER_TOKEN_FILE=/etc/q-academy/prometheus-app-token
PROMETHEUS_MEDIA_BEARER_TOKEN_FILE=/etc/q-academy/prometheus-media-token
BACKUP_METRICS_DIR=/var/lib/q-academy-observability

# The exact APP_DOMAIN resolves only to this existing active tenant slug.
DEFAULT_ORGANIZATION_SLUG=q-academy
TENANT_BASE_DOMAIN=

EMAIL_DELIVERY_WEBHOOK_URL=https://mail-gateway.example.com/q-academy
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_DELIVERY_INBOUND_SECRET=
EMAIL_DELIVERY_RETENTION_DAYS=90
WEBHOOK_DELIVERY_RETENTION_DAYS=90
PUSH_DELIVERY_RETENTION_DAYS=90

LEGAL_IMPRINT_URL=https://www.example.com/impressum
LEGAL_PRIVACY_URL=https://www.example.com/datenschutz
SUPPORT_EMAIL=support@example.com

# Generate once and retain for the lifetime of existing browser subscriptions.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:push@example.com

# Private S3-compatible bucket. `versioned` is the strict production contract.
# STRATO HiDrive Object Storage requires endpoint
# `https://s3.hidrive.strato.com`, region `eu-central-1`, path-style access,
# mode `strato-hidrive` and an explicit acceptance flag.
# The reduced STRATO guarantees and mandatory compensating controls are
# documented in docs/S3_PROVIDER_CONTRACT.md.
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=https://objects.example.com
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_BUCKET=q-academy-production-media
# Low-privilege principal for signed staging PUTs and ready-object GETs.
MEDIA_S3_APP_ACCESS_KEY_ID=
MEDIA_S3_APP_SECRET_ACCESS_KEY=
# Separate worker principal for scan, promotion and version-aware harddelete.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_S3_COMPATIBILITY_MODE=versioned
MEDIA_S3_STRATO_LIMITATIONS_ACCEPTED=false
MEDIA_MAX_UPLOAD_BYTES=2000000000
MEDIA_TENANT_QUOTA_BYTES=536870912000
MEDIA_SIGNED_UPLOAD_TTL_SECONDS=900
MEDIA_SIGNED_DOWNLOAD_TTL_SECONDS=900
MEDIA_CLAMAV_HOST=clamav
MEDIA_CLAMAV_PORT=3310
# Dedicated host mount backed by a bounded disk filesystem. Its root and
# sentinel stay root-owned; only the UID/GID-1001 `work/` child is writable.
# It must be mounted nodev,nosuid,noexec and is not a general data volume.
MEDIA_PROCESSING_WORK_DIR=/var/lib/q-academy-media-processing
MEDIA_FFMPEG_TIMEOUT_SECONDS=10800
MEDIA_TRANSCRIPT_TIMEOUT_SECONDS=7200
# Dedicated OpenAI transcription key file. The production Compose mounts this
# file only into media-runner and media-preflight. On the host it must be a
# regular file owned by UID/GID 1001 with mode 0400.
OPENAI_TRANSCRIPTION_API_KEY_SOURCE_FILE=/etc/q-academy/openai-transcription-api-key

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional provider-neutral stock image adapter; leave all values empty to
# remove the Stock mode from the course media picker.
STOCK_IMAGE_PROVIDER_NAME=
STOCK_IMAGE_PROVIDER_BASE_URL=
STOCK_IMAGE_PROVIDER_API_KEY=
STOCK_IMAGE_ALLOWED_HOSTS=

JOB_DISPATCH_INTERVAL_SECONDS=15
MAINTENANCE_CLEANUP_INTERVAL_SECONDS=3600
SCHEDULER_MAX_CONSECUTIVE_FAILURES=5
SCHEDULER_HEARTBEAT_STALE_SECONDS=180
MEDIA_WORKER_POLL_SECONDS=10
MEDIA_WORKER_MAX_CONSECUTIVE_FAILURES=3
MEDIA_WORKER_HEARTBEAT_STALE_SECONDS=15000
MEDIA_MAINTENANCE_INTERVAL_SECONDS=60
MEDIA_MAINTENANCE_MAX_CONSECUTIVE_FAILURES=3
MEDIA_MAINTENANCE_HEARTBEAT_STALE_SECONDS=700
