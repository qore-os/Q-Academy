{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	admin off

	on_demand_tls {
		ask http://127.0.0.1:9080/api/internal/caddy/tls-ask
	}
}

(app_backend) {
	encode zstd gzip

	request_body {
		max_size 16MB
	}

	header {
		-Server
	}

	log {
		output stdout
		format filter {
			request>uri regexp [?].*$ ""
			wrap json
		}
	}

	route {
		@internal_jobs path /api/internal/*
		respond @internal_jobs 404

		@multipart_status_recovery {
			method GET POST
			path_regexp multipart_status_recovery ^/api/v1/media-assets/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}/multipart$
		}
		reverse_proxy @multipart_status_recovery q-academy-app:3000 {
			fail_duration 30s
			flush_interval -1

			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}

			transport http {
				dial_timeout 5s
				response_header_timeout 5m
				keepalive 30s
			}
		}

		@multipart_complete path_regexp multipart_complete ^/api/(v1/)?media-assets/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}/complete$
		reverse_proxy @multipart_complete q-academy-app:3000 {
			fail_duration 30s
			flush_interval -1

			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}

			transport http {
				dial_timeout 5s
				response_header_timeout 15m
				keepalive 30s
			}
		}

		@multipart_delete {
			method DELETE
			path_regexp multipart_delete ^/api/(media-assets/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|v1/media-assets/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}/multipart)$
		}
		reverse_proxy @multipart_delete q-academy-app:3000 {
			fail_duration 30s
			flush_interval -1

			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}

			transport http {
				dial_timeout 5s
				response_header_timeout 15m
				keepalive 30s
			}
		}

		reverse_proxy q-academy-app:3000 {
			health_uri /api/v1/health/ready
			health_interval 15s
			health_timeout 5s
			fail_duration 30s
			flush_interval -1

			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}

			transport http {
				dial_timeout 5s
				response_header_timeout 60s
				keepalive 30s
			}
		}
	}
}

{$CADDY_SITE_ADDRESSES} {
	import app_backend
}

https:// {
	tls {
		on_demand
	}

	import app_backend
}

http://127.0.0.1:9080 {
	bind 127.0.0.1

	handle /api/internal/caddy/tls-ask {
		reverse_proxy tls-ask-app:3000 {
			header_up Host tls-ask-app
			header_up Authorization "Bearer {$CADDY_TLS_ASK_SECRET}"
			header_up -Cookie

			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
		}
	}

	handle {
		respond 404
	}
}

# Root-owned co-hosted site definitions live outside the release checkout so
# deployments cannot silently discard or absorb another application's route.
import /etc/caddy/sites/*.caddy
