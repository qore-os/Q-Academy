# Production requires a dedicated non-superuser role and a random password
# with at least 16 characters. This postgres/postgres URL is development-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/q_academy
# Required in production: use unique random values with at least 32 characters.
SESSION_SECRET=
AUTH_RATE_LIMIT_SECRET=
# Dedicated Caddy-to-app bearer secret; required only in production.
CADDY_TLS_ASK_SECRET=
# Enable only behind a trusted proxy that replaces inbound X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Exact platform hostname. In production it must match NEXT_PUBLIC_APP_URL.
APP_DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional in development; production registers the service worker automatically.
NEXT_PUBLIC_ENABLE_PWA=false
# Generate this pair once with `npx web-push generate-vapid-keys --json`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:push@example.com
DEFAULT_ORGANIZATION_SLUG=q-academy
# Optional parent domain for exact <tenant-slug>.<base-domain> login hosts.
TENANT_BASE_DOMAIN=
API_ALLOWED_ORIGIN=http://localhost:3000
ENABLE_DEMO_LOGIN=false
DEMO_API_KEY=qak_demo_qacademy_2026_local_development
# Destructive demo seed requires both values and accepts loopback databases only.
ALLOW_DESTRUCTIVE_SEED=false
SEED_EXPECTED_DATABASE=
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY_ID=local-webhook-v1
WEBHOOK_ENCRYPTION_PREVIOUS_KEYS=
DATA_ENCRYPTION_KEY=
# TOTP secrets use this keyring. Retain previous keys until the rotation check
# reports `mfaTotpSecrets: 0`.
DATA_ENCRYPTION_KEY_ID=local-data-v1
DATA_ENCRYPTION_PREVIOUS_KEYS=
# Operator-only HMAC key for audit and tenant-erasure evidence manifests.
AUDIT_EXPORT_HMAC_KEY=
AUDIT_EXPORT_HMAC_KEY_ID=local-audit-v1
# Technical floor; contracts and legal decisions may require a longer period.
TENANT_ERASURE_MIN_WAIT_DAYS=30
MFA_RECOVERY_PEPPER=
MFA_RECOVERY_PEPPER_ID=local-mfa-recovery-v1
# JSON object mapping retained pepper IDs to their old secrets.
MFA_RECOVERY_PREVIOUS_PEPPERS=
EXAM_SELECTION_SECRET=
CRON_SECRET=
# Read-only Prometheus bearer token. Must differ from CRON_SECRET in production.
METRICS_SECRET=
# Set true in production when account links must be delivered by mail.
EMAIL_DELIVERY_REQUIRED=false
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
# Dedicated HMAC secret for signed bounce/complaint callbacks. Must differ
# from every outbound, session, worker, encryption, and privacy secret.
EMAIL_DELIVERY_INBOUND_SECRET=
# Completed delivery records only; active queue entries are never removed.
EMAIL_DELIVERY_RETENTION_DAYS=90
WEBHOOK_DELIVERY_RETENTION_DAYS=90
PUSH_DELIVERY_RETENTION_DAYS=90
COMMUNITY_AUTHOR_BOOST_RETENTION_DAYS=90
# Required in production and must point to approved, non-example contacts.
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=
SUPPORT_EMAIL=
# Development defaults to a private filesystem below .data/media. Production
# requires S3-compatible HTTPS storage plus a reachable ClamAV daemon.
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_FILESYSTEM_ROOT=.data/media
MEDIA_MAX_UPLOAD_BYTES=2000000000
MEDIA_TENANT_QUOTA_BYTES=536870912000
MEDIA_SIGNED_UPLOAD_TTL_SECONDS=900
MEDIA_SIGNED_DOWNLOAD_TTL_SECONDS=900
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
# Keep `versioned` for the strict S3 contract. STRATO HiDrive requires
# `strato-hidrive`, path style and explicit limitation acceptance; see
# docs/S3_PROVIDER_CONTRACT.md.
MEDIA_S3_COMPATIBILITY_MODE=versioned
MEDIA_S3_STRATO_LIMITATIONS_ACCEPTED=false
MEDIA_CLAMAV_HOST=127.0.0.1
MEDIA_CLAMAV_PORT=3310
# Optional local media processors. Production S3 processing needs an isolated
# S3-capable runner; see docs/MEDIA_PROCESSING.md.
MEDIA_FFMPEG_PATH=
MEDIA_TRANSCRIPT_COMMAND=
MEDIA_TRANSCRIPT_COMMAND_ARGS_JSON=
MEDIA_TRANSCRIPT_SIDECAR_DIRECTORY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional and disabled unless all four values are set. Responses and tracking
# may use only the exact comma-separated HTTPS hosts in the allowlist.
STOCK_IMAGE_PROVIDER_NAME=
STOCK_IMAGE_PROVIDER_BASE_URL=
STOCK_IMAGE_PROVIDER_API_KEY=
STOCK_IMAGE_ALLOWED_HOSTS=
# Native app build and verified deep-link association (deployment-specific)
CAPACITOR_SERVER_URL=https://academy.example.com
MOBILE_APP_NAME=Q-Academy
MOBILE_APP_BUNDLE_ID=com.qacademy.mobile
MOBILE_APP_URL_SCHEME=qacademy
MOBILE_ASSOCIATED_DOMAIN=academy.example.com
MOBILE_BUILD_NUMBER=1
MOBILE_VERSION=1.0.0
ANDROID_KEYSTORE_PATH=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
APPLE_TEAM_ID=
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_CLIENT_EMAIL=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.qacademy.mobile
APNS_PRODUCTION=false
