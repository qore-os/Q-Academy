{
  "name": "q-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "api:check-contract": "tsx scripts/check-openapi.ts",
    "security:scan-secrets": "tsx scripts/secret-scan.ts",
    "security:scan-secrets:history": "tsx scripts/secret-scan.ts --history",
    "notices:generate": "tsx scripts/generate-third-party-notices.ts",
    "notices:check": "tsx scripts/generate-third-party-notices.ts --check",
    "ai:course-provider:preflight": "node --conditions=react-server --import tsx scripts/ai-course-provider-preflight.ts",
    "media:s3:preflight": "tsx scripts/s3-provider-preflight.ts",
    "media:s3:app-principal-preflight": "tsx scripts/s3-app-principal-preflight.ts",
    "media:clamav:preflight": "tsx scripts/clamav-preflight.ts",
    "media:processing:preflight": "node --conditions=react-server --import tsx scripts/media-processing-preflight.ts",
    "test:unit": "tsx --test tests/*.unit.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:production-config": "tsx --test tests/production-config.unit.ts",
    "test:http-slo": "tsx scripts/http-slo-smoke.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:accessibility": "playwright test tests/accessibility-smoke.spec.ts --project=chromium",
    "test:backup-restore-drill": "tsx scripts/run-postgres-backup-restore-drill.ts",
    "test:backup-restore-drill:required": "tsx scripts/run-postgres-backup-restore-drill.ts --require",
    "db:dev": "tsx scripts/dev-postgres.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test-migrations": "tsx scripts/test-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:studio": "drizzle-kit studio",
    "tenant:provision": "tsx scripts/provision-tenant.ts",
    "tenant:status": "tsx scripts/set-tenant-status.ts",
    "tenant:contract": "tsx scripts/set-tenant-contract.ts",
    "tenant:erase": "node --conditions=react-server --import tsx scripts/erase-tenant.ts",
    "tenant:erase:verify": "tsx scripts/verify-tenant-erasure-archive.ts",
    "audit:export": "tsx scripts/export-audit-events.ts",
    "audit:verify": "tsx scripts/verify-audit-export.ts",
    "encryption:rotate": "tsx scripts/rotate-encryption-keys.ts",
    "user-data:export": "tsx scripts/export-user-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "mobile:sync": "tsx scripts/mobile-sync.ts",
    "mobile:configure": "tsx scripts/mobile-configure.ts",
    "mobile:preflight": "tsx scripts/mobile-preflight.ts",
    "mobile:preflight:android": "tsx scripts/mobile-preflight.ts --platform=android",
    "mobile:preflight:ios": "tsx scripts/mobile-preflight.ts --platform=ios",
    "connectors:check": "tsx --test tests/automation-connectors.unit.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "mobile:android": "capacitor open android",
    "mobile:ios": "capacitor open ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/link": "^0.47.0",
    "@lexical/list": "^0.47.0",
    "@lexical/react": "^0.47.0",
    "@lexical/rich-text": "^0.47.0",
    "@lexical/selection": "^0.47.0",
    "@smithy/node-http-handler": "^4.9.5",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.3",
    "lexical": "^0.47.0",
    "lucide-react": "^1.24.0",
    "mp4box": "^2.4.1",
    "music-metadata": "^11.13.0",
    "next": "16.2.10",
    "openid-client": "^6.8.4",
    "papaparse": "^5.5.4",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^5.7.284",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
