{
  "url": "/api/v1/automation/members/upsert",
  "method": "POST",
  "headers": {
    "idempotency-key": "{{parameters.idempotencyKey}}"
  },
  "body": {
    "email": "{{parameters.email}}",
    "firstName": "{{ifempty(parameters.firstName, 'Mitglied')}}",
    "lastName": "{{ifempty(parameters.lastName, '')}}",
    "bundleId": "{{ifempty(parameters.bundleId, null)}}",
    "bundleAction": "grant",
    "sendInvitation": "{{ifempty(parameters.sendInvitation, true)}}"
  },
  "response": {
    "output": "{{body.data}}"
  }
}
