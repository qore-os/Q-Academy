{
  "name": "q-academy-zapier",
  "version": "1.0.0",
  "description": "Private Zapier integration for the Q-Academy automation API.",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "clean": "rimraf ./dist ./build",
    "compile": "npm run clean && tsc",
    "build": "npm run compile && zapier-platform build",
    "test": "npm run compile && vitest --run",
    "typecheck": "tsc --noEmit",
    "validate": "npm run compile && zapier-platform validate",
    "_zapier-build": "npm run compile"
  },
  "dependencies": {
    "zapier-platform-core": "19.0.0"
  },
  "devDependencies": {
    "nock": "13.5.4",
    "rimraf": "5.0.10",
    "typescript": "5.6.2",
    "vitest": "4.1.10",
    "zapier-platform-cli": "19.0.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
